MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
DB_PASSWORD=replace-with-a-local-app-password
# Docker frontend URL: http://localhost:8080
WEB_PORT=8080
# Browser-visible CARTO Basemaps key, embedded when the frontend is built.
VITE_CARTO_BASEMAP_API_KEY=
# Optional key used by the explicit container import command.
DGS_API_KEY=
# Host development database port (docker-compose.dev.yml only).
DB_PUBLISHED_PORT=3306
