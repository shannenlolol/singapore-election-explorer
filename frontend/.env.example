# Copy to .env.local for local development; on Vercel, set these as project environment variables.

# Browser-visible CARTO Basemaps key, embedded when the frontend is built (optional).
VITE_CARTO_BASEMAP_API_KEY=

# Optional data.gov.sg key for `npm run build:data` (not read from this file; export it in your shell).
# DGS_API_KEY=
